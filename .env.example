# ====================================================================
# TECHTOOLS HUB - VARIÁVEIS DE AMBIENTE & PARÂMETROS PARA O GOOGLE
# ====================================================================

# 1. URL Canônica do Site em Produção (Necessária para Sitemap e Hreflang)
NEXT_PUBLIC_SITE_URL=https://seusite.com

# 2. Código de Verificação do Google Search Console
# Obtenha em: https://search.google.com/search-console (Método: HTML tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=google_verification_code_aqui

# 3. Google Analytics 4 (ID de Medição GA4)
# Formato: G-XXXXXXXXXX (Obtenha no Google Analytics > Fluxos de Dados)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# 4. Chave Mestra de Acesso ao Painel do Administrador (/admin)
NEXT_PUBLIC_ADMIN_PIN=admin123
